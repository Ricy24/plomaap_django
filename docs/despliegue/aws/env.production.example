# Plantilla de variables de entorno para producción (AWS / Vercel).
# Copiar a .env y reemplazar todos los valores. NUNCA versionar el .env real.

# Django
SECRET_KEY=genera-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=plomaap-api.vercel.app,.vercel.app,plomaap.duckdns.org,18-221-80-56.nip.io,18.221.80.56,localhost,127.0.0.1

# Base de datos (Neon)
# AWS usa el host directo; Vercel usa el host con -pooler.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require
PGSSLMODE=require

# JWT
JWT_SECRET_KEY=genera-otra-clave-larga-y-aleatoria
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ALLOW_ALL_ORIGINS=True
CORS_ORIGINS=https://plomaap-react.vercel.app

# Google
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Correo (Zoho)
MAIL_SERVER=smtp.zoho.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=tu-correo@zohomail.com
MAIL_PASSWORD=tu-password

# App
APP_NAME=PlomApp
APP_VERSION=1.0.0

# IA
GEMINI_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-lite

# Passkeys (debe coincidir con el dominio del frontend)
WEBAUTHN_RP_ID=plomaap-react.vercel.app
WEBAUTHN_RP_NAME=PlomApp
WEBAUTHN_ORIGIN=https://plomaap-react.vercel.app

# Seguridad detrás de proxy TLS
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=https://plomaap-react.vercel.app,https://plomaap.duckdns.org
