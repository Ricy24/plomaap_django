    WS --> NATIVEPG
    WS --> MYSQL
    WS --> SQLITE
    REPO --> JOBS
    JOBS --> ARTS
    FRONTREPO -.->|"Vercel CLI"| VCDN
    REPO -.->|"Vercel CLI"| VAPI
    REPO -.->|"git pull + systemd"| NGINX
    REPO -.->|"git pull + docker compose"| OAPI
    OPSBOX -.->|"operación"| HAPROXY
    OPSBOX -.->|"operación"| NGINX
    OPSBOX -.->|"operación"| OAPI
    OPSBOX -.->|"operación"| VAPI

