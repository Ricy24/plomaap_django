# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL activo / MySQL standby / SQLite fallback)
# 5434 = contenedor Docker "plomapp-postgres-pgvector" (pgvector/pgvector:pg17)
# 5432 = PostgreSQL nativo de Windows (respaldo, sin pgvector)
DB_ENGINE=postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=plomapp

# MySQL (respaldo)
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=plomapp

# Google Login
GOOGLE_CLIENT_ID=

# JWT Authentication (mismo secreto que Flask para no invalidar sesiones)
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Zoho SMTP)
MAIL_SERVER=smtp.zoho.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=
MAIL_PASSWORD=

# App
APP_NAME=PlomApp
APP_VERSION=1.0.0

# Integraciones IA
GEMINI_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-lite

# Passkeys (WebAuthn)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PlomApp
WEBAUTHN_ORIGIN=http://localhost:5000

# ---------------------------------------------------------------------------
# Seguridad para PRODUCCIÓN (en local se dejan apagadas)
# ---------------------------------------------------------------------------
# DEBUG=False
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ORIGINS=https://tudominio.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# USE_X_FORWARDED_PROTO=True
# CSRF_TRUSTED_ORIGINS=https://tudominio.com
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
# FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
